<Window x:Class="GK1_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GK1_1"
        xmlns:converters ="clr-namespace:GK1_1.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1000"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:AddValueConverter x:Key="AddValueConverter"/>
        <converters:PointConverter x:Key="PointConverter"/>
        <converters:RadiusSizeConverter x:Key="RadiusSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolEdgeTypeConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ContinuityConverter x:Key="ContinuityConverter"/>
        <converters:MidPointConverter x:Key="MidPointConverter"/>

        <Style TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ViewModel.Library}" Value="true">
                    <Setter Property="Background" Value="Black"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=ViewModel.Library}" Value="false">
                    <Setter Property="Background" Value="Transparent"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel>

        <StackPanel Width="1000" Height="50" Orientation="Horizontal">
            <RadioButton IsChecked="{Binding Path=ViewModel.Library, Mode=TwoWay}" GroupName="Drawing"  VerticalContentAlignment="Center"></RadioButton>
            <Label Content="Library" VerticalContentAlignment="Center"></Label>
            <RadioButton IsChecked="{Binding Path=ViewModel.Bresenham, Mode=TwoWay}" GroupName="Drawing"  VerticalContentAlignment="Center"></RadioButton>
            <Label Content="Bresenham" VerticalContentAlignment="Center"></Label>
            <Button Margin="50,0,0,0" Width="200" Height="25" Click="Button_Click">View Documentation</Button>
        </StackPanel>
        <Grid Width="1000" Height="700" x:Name="grid">
            <Image Source="{Binding BMP}" Visibility="{Binding Path=ViewModel.Bresenham ,
                    Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter={}}">
            </Image>
            <ItemsControl ItemsSource="{Binding Shapes}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid>
                            <ItemsControl ItemsSource="{Binding Edges}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line 
                                            X1="{Binding P1.X}" 
                                            Y1="{Binding P1.Y}"
                                            X2="{Binding P2.X}"
                                            Y2="{Binding P2.Y}"
                                            Stroke="White">
                                                <Line.Visibility>
                                                    <MultiBinding Converter="{StaticResource BoolEdgeTypeConverter}">
                                                        <Binding RelativeSource="{RelativeSource FindAncestor, 
AncestorType={x:Type Window}}" Path="ViewModel.Library"></Binding>
                                                        <Binding></Binding>
                                                    </MultiBinding>
                                                </Line.Visibility>
                                                
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsVisible}" Value="false">
                                                                <Setter Property="StrokeDashArray" Value="1,0"></Setter>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Path=IsVisible}" Value="true">
                                                                <Setter Property="StrokeDashArray" Value="5,5"></Setter>
                                                                <Setter Property="Visibility" Value="Visible"></Setter>
                                                            </DataTrigger>
                                                            
                                                        </Style.Triggers>
                                                    
                                                    </Style>
                                                </Line.Style>
                                                
                                            </Line>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Edges}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource MidPointConverter}">
                                                    <Binding Path="P1.X"/>
                                                    <Binding Path="P2.X"/>
                                                </MultiBinding>
                                            </Setter.Value>

                                        </Setter>
                                        <Setter Property="Canvas.Top">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource MidPointConverter}">
                                                    <Binding Path="P1.Y"/>
                                                    <Binding Path="P2.Y"/>
                                                </MultiBinding>
                                            </Setter.Value>

                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>


                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Vertical">
                                            <Label Content="{Binding Path=FixedLength}" Foreground="Red"></Label>
                                            <Label Content="{Binding Path=Index}" Foreground="Yellow"></Label>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <ItemsControl ItemsSource="{Binding Vertices}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Path=X, Converter={StaticResource AddValueConverter},
ConverterParameter=-5}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Path=Y, Converter={StaticResource AddValueConverter},
                   ConverterParameter=-5}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Label Foreground="White" Content="{Binding Path=Continuity,Converter={StaticResource ContinuityConverter}}"></Label>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Vertices}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Path=X, Converter={StaticResource AddValueConverter},
ConverterParameter=-5}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Path=Y, Converter={StaticResource AddValueConverter},
ConverterParameter=-5}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Height="10" Width="10" Stroke="White" Fill="White"></Ellipse>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <ItemsControl ItemsSource="{Binding ControlPoints}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Path=X, Converter={StaticResource AddValueConverter},
ConverterParameter=-5}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Path=Y, Converter={StaticResource AddValueConverter},
ConverterParameter=-5}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Height="10" Width="10" Stroke="White" Fill="Black"></Ellipse>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding CircularEdges}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Path Stroke="White" StrokeThickness="1">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathFigure>
                                                            <PathFigure.StartPoint>
                                                                <MultiBinding Converter="{StaticResource PointConverter}">
                                                                    <Binding Path="P1.X"/>
                                                                    <Binding Path="P1.Y"/>
                                                                </MultiBinding>
                                                            </PathFigure.StartPoint>
                                                            <ArcSegment 
                            SweepDirection="{Binding SweepDirection}"
                            IsLargeArc="{Binding IsLargeArc}" >
                                                                <ArcSegment.Point>
                                                                    <MultiBinding Converter="{StaticResource PointConverter}">
                                                                        <Binding Path="P2.X"/>
                                                                        <Binding Path="P2.Y"/>
                                                                    </MultiBinding>
                                                                </ArcSegment.Point>
                                                                <ArcSegment.Size>
                                                                    <MultiBinding Converter="{StaticResource RadiusSizeConverter}">
                                                                        <Binding Path="BetweenRadius"/>
                                                                        <Binding Path="Radius"/>
                                                                    </MultiBinding>
                                                                </ArcSegment.Size>
                                                                
                                                            </ArcSegment>

                                                        </PathFigure>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding BezierEdges}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MidLines}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>


                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Line 
                                            X1="{Binding P1.X}" 
                                            Y1="{Binding P1.Y}"
                                            X2="{Binding P2.X}"
                                            Y2="{Binding P2.Y}"
                                            Stroke="White">

                                                        </Line>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                
                                
                            </ItemsControl>


                            <ItemsControl ItemsSource="{Binding FakeEdges}">


                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line 
                                            X1="{Binding P1.X}" 
                                            Y1="{Binding P1.Y}"
                                            X2="{Binding P2.X}"
                                            Y2="{Binding P2.Y}"
                                            Stroke="White" StrokeDashArray="5,5">
                                            </Line>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>
    </StackPanel>
</Window>
